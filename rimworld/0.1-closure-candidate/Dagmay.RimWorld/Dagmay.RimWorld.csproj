<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Dagmay.RimWorld</AssemblyName>
    <RootNamespace>Dagmay.RimWorld</RootNamespace>
    <Description>Observer-only RimWorld environment adapter for Dagmay.</Description>
    <RimWorldInstallDir Condition="'$(RimWorldInstallDir)' == '' and '$(OS)' == 'Windows_NT'">$(MSBuildProgramFiles32)\Steam\steamapps\common\RimWorld</RimWorldInstallDir>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">$(RimWorldInstallDir)\RimWorldWin64_Data\Managed</RimWorldManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dagmay.Core\Dagmay.Core.csproj" />
    <ProjectReference Include="..\Dagmay.Providers\Dagmay.Providers.csproj" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="Exists('$(RimWorldManagedDir)\UnityEngine.CoreModule.dll')">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule" Condition="Exists('$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll')">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule" Condition="Exists('$(RimWorldManagedDir)\UnityEngine.TextRenderingModule.dll')">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine" Condition="Exists('$(RimWorldManagedDir)\UnityEngine.dll')">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateRimWorldReferences" BeforeTargets="ResolveReferences">
    <Error
      Condition="!Exists('$(RimWorldManagedDir)\Assembly-CSharp.dll')"
      Text="RimWorld Assembly-CSharp.dll was not found. Pass -p:RimWorldInstallDir=&quot;C:\path\to\RimWorld&quot; or use tools/build.ps1." />
    <Error
      Condition="!Exists('$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll')"
      Text="RimWorld UnityEngine.IMGUIModule.dll was not found in the Managed directory. Verify the RimWorld 1.6 installation or pass the correct RimWorldInstallDir." />
    <Error
      Condition="!Exists('$(RimWorldManagedDir)\UnityEngine.TextRenderingModule.dll')"
      Text="RimWorld UnityEngine.TextRenderingModule.dll was not found in the Managed directory. Verify the RimWorld 1.6 installation or pass the correct RimWorldInstallDir." />
  </Target>

  <Target Name="CopyToModPackage" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\Package\Assemblies" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\Package\Assemblies" />
    <Copy SourceFiles="$(TargetDir)Dagmay.Core.dll" DestinationFolder="$(MSBuildProjectDirectory)\Package\Assemblies" />
    <Copy SourceFiles="$(TargetDir)Dagmay.Providers.dll" DestinationFolder="$(MSBuildProjectDirectory)\Package\Assemblies" />
    <Copy
      SourceFiles="$(TargetDir)$(AssemblyName).pdb"
      DestinationFolder="$(MSBuildProjectDirectory)\Package\Assemblies"
      Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
  </Target>
</Project>
